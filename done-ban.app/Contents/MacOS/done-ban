#!/usr/bin/env bash
# Startet done-ban ohne Terminal-Fenster. Das Bundle liegt im Projektordner,
# drei Ebenen ueber dieser Datei (Contents/MacOS/done-ban).
#
# Protokolliert wird nur, wenn der Start fehlschlaegt: Die Zeilen werden
# gesammelt und erst im Fehlerfall nach ~/Library/Logs/done-ban.log
# geschrieben. Das Protokoll liegt ausserhalb des Projekts, damit es auch
# dann beschreibbar ist, wenn der Projektordner nicht gelesen werden darf.
PROTOKOLL="$HOME/Library/Logs/done-ban.log"
ZEILEN=""

notiere() { ZEILEN="${ZEILEN}$(date '+%Y-%m-%d %H:%M:%S') $*"$'\n'; }

# Schreibt das gesammelte Protokoll und oeffnet start.command im Terminal,
# damit die Meldung auch ohne Fenster sichtbar wird.
scheitern() {
  notiere "$1"
  mkdir -p "$(dirname "$PROTOKOLL")" 2>/dev/null
  printf '%s' "$ZEILEN" >> "$PROTOKOLL"
  [ -n "$PROJEKT" ] && open -a Terminal "$PROJEKT/start.command"
  exit 1
}

notiere "--- Start über done-ban.app ---"
notiere "Aufruf: $0"
notiere "PATH: $PATH"

PROJEKT="$(cd "$(dirname "$0")/../../.." && pwd)"
[ -n "$PROJEKT" ] || scheitern "FEHLER: Projektordner nicht erreichbar."
notiere "Projektordner: $PROJEKT"

cd "$PROJEKT" 2>/dev/null || scheitern "FEHLER: Wechsel in den Projektordner nicht möglich (Rechte?)."
[ -x start.sh ] || scheitern "FEHLER: start.sh fehlt oder ist nicht ausführbar."

# start.sh startet den Server im Hintergrund und kehrt zurueck, sobald er laeuft.
AUSGABE=$(DONE_BAN_DETACH=1 ./start.sh 2>&1 </dev/null)
STATUS=$?
notiere "start.sh beendet mit Status $STATUS"
[ -n "$AUSGABE" ] && notiere "Ausgabe: $AUSGABE"

# Erfolg: Es wird nichts protokolliert.
[ $STATUS -eq 0 ] && exit 0

scheitern "Fehlschlag, öffne start.command im Terminal."
